{
    "name": "pauldeano/dromos",
    "description": "A small, fast PHP router for APIs: PSR-7, PSR-15 and PSR-17, with a lean mode and an opcache route cache",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Dromos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dromos\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Paul Dean",
            "email": "pauldeano123@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2",
        "psr/http-factory": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1",
        "nyholm/psr7": "^1.8",
        "php-http/psr7-integration-tests": "^1.4",
        "http-interop/http-factory-tests": "^2.2"
    },
    "suggest": {
        "ext-openswoole": "Needed for SwooleEmitter (OpenSwoole 22 or later)"
    }
}
