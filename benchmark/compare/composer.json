{
    "name": "pauldeano/dromos-router-comparison",
    "description": "Head-to-head benchmark of Dromos against other PHP routers. Not part of the Dromos package.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "pauldeano/dromos": "*",
        "flightphp/core": "^3.15",
        "illuminate/routing": "^12.0",
        "illuminate/events": "^12.0",
        "nikic/fast-route": "^1.3",
        "symfony/routing": "^7.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "pauldeano/dromos": "1.2.0"
                }
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Bench\\": "src/"
        }
    }
}
