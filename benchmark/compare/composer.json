{
    "name": "pauldeano/dromos-router-comparison",
    "description": "Head-to-head benchmark of Dromos against other PHP routers. Not part of the Dromos package.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "flightphp/core": "^3.15",
        "illuminate/events": "^12.0",
        "illuminate/routing": "^12.0",
        "laminas/laminas-config-aggregator": "^1.20",
        "laminas/laminas-diactoros": "^3.9",
        "laminas/laminas-servicemanager": "^4.5",
        "mezzio/mezzio": "^3.20",
        "mezzio/mezzio-fastroute": "^3.12",
        "nikic/fast-route": "^1.3",
        "pauldeano/dromos": "*",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/routing": "^7.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "pauldeano/dromos": "1.2.0"
                }
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Bench\\": "src/"
        }
    }
}
